+static bool runCancellable(QProcess &proc, int timeoutMs, const std::atomic<bool> *cancelled,
+                           const char *what)
+{
+    proc.start();
+    if (!proc.waitForStarted(10'000)) {
+        qCritical() << "[KaraokeWorker]" << what << "не запустился:" << proc.errorString();
+        return false;
+    }
